+void TakeRawMouseDelta(float& dx, float& dy, double& seconds_since_last_take) {
+  std::lock_guard lock(raw_mouse_mutex);
+  auto now = std::chrono::steady_clock::now();
+  seconds_since_last_take = raw_mouse_last_take.time_since_epoch().count() == 0
+                                ? 1e9
+                                : std::chrono::duration<double>(now - raw_mouse_last_take).count();
+  raw_mouse_last_take = now;
+  dx = raw_mouse_dx;
+  dy = raw_mouse_dy;
+  raw_mouse_dx = 0.0f;
+  raw_mouse_dy = 0.0f;
+}
