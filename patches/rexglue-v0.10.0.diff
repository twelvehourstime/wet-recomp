+// wet-recomp patch: present guest frames on a fixed cadence instead of the moment the guest
+// finishes them. The host presents without vsync (tearing / VRR), so without this the
+// frame-to-frame variation of the guest's render time (measured +-2 ms) goes straight to the
+// display as judder. Each present waits for the next period boundary (at most one period of
+// added latency); if the guest falls behind, the schedule re-syncs instead of queueing.
+REXCVAR_DEFINE_DOUBLE(present_pace_hz, 60.0, "UI/Presenter",
+                      "Present guest output on a fixed cadence of this many Hz (0 = as soon as "
+                      "each frame is ready)")
+    .range(0.0, 500.0);
+
+// wet-recomp patch: host vertical sync. Presents with sync interval 1 and no tearing (the
+// display's refresh paces the frames, so the fixed cadence above is not used meanwhile).
+REXCVAR_DEFINE_BOOL(host_vsync, false, "UI/Presenter",
+                    "Wait for the display's vertical sync when presenting (no tearing)");
+
+namespace {
+// wet-recomp patch (host_vsync): set when the guest publishes a frame; the UI thread paints
+// on it rather than on the generic paint request, which UI drawers re-arm after every paint.
+std::atomic<bool> g_host_vsync_guest_paint_pending{false};
+}  // namespace
+
+namespace {
+
+void PaceGuestPresent() {
+  static uint64_t next_deadline = 0;
+  static uint64_t last_present = 0;
+  const uint64_t freq = rex::chrono::Clock::QueryHostTickFrequency();
+  const double hz = REXCVAR_GET(host_vsync) ? 0.0 : REXCVAR_GET(present_pace_hz);
+  uint64_t now = rex::chrono::Clock::QueryHostTickCount();
+  if (hz > 0.0) {
+    const uint64_t period = uint64_t(double(freq) / hz);
+    if (next_deadline == 0 || now > next_deadline + period) {
+      next_deadline = now;  // first frame, or fell behind: re-sync rather than catch up
+    }
+    if (now < next_deadline) {
+#if REX_PLATFORM_WIN32
+      static HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr,
+                                                  CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                                  TIMER_ALL_ACCESS);
+      int64_t remaining_100ns = int64_t((next_deadline - now) * 10000000ull / freq) - 5000;
+      if (timer && remaining_100ns > 0) {
+        LARGE_INTEGER due;
+        due.QuadPart = -remaining_100ns;
+        if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+          WaitForSingleObject(timer, INFINITE);
+        }
+      }
+#endif
+      while ((now = rex::chrono::Clock::QueryHostTickCount()) < next_deadline) {
+#if REX_PLATFORM_WIN32
+        YieldProcessor();
+#else
+        std::this_thread::yield();
+#endif
+      }
+    }
+    next_deadline += period;
+  }
+  (void)last_present;
+}
