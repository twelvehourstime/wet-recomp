+// wet-recomp patch
+bool WindowSDL::SetExclusiveFullscreenMode(bool exclusive) {
+  if (!sdl_window_) {
+    return false;
+  }
+  bool ok = true;
+  if (exclusive) {
+    SDL_DisplayID display = SDL_GetDisplayForWindow(sdl_window_);
+    const SDL_DisplayMode* desktop = SDL_GetDesktopDisplayMode(display);
+    SDL_DisplayMode closest{};
+    ok = desktop && SDL_GetClosestFullscreenDisplayMode(display, desktop->w, desktop->h,
+                                                        desktop->refresh_rate, false, &closest);
+    if (ok) {
+      ok = SDL_SetWindowFullscreenMode(sdl_window_, &closest);
+      REXLOG_INFO("WindowSDL: exclusive fullscreen mode {}x{} @ {:.2f} Hz ({})", closest.w,
+                  closest.h, closest.refresh_rate, ok ? "ok" : SDL_GetError());
+    } else {
+      REXLOG_WARN("WindowSDL: no exclusive mode for the desktop resolution: {}", SDL_GetError());
+    }
+  } else {
+    ok = SDL_SetWindowFullscreenMode(sdl_window_, nullptr);  // borderless desktop
+  }
+  if (IsFullscreen()) {
+    // The flag does not change, so re-apply so the new mode takes effect now.
+    SDL_SetWindowFullscreen(sdl_window_, true);
+  }
+  return ok;
+}
