+// wet-recomp patch: persistent copy workers. The pool is leaked on purpose (detached threads
+// sleeping on its condition variable must not outlive a destroyed pool at process exit).
+namespace {
+struct UploadCopyPool {
+  std::mutex mutex;
+  std::condition_variable wake;
+  uint64_t generation = 0;
+  const UploadCopyJob* jobs = nullptr;
+  size_t job_count = 0;
+  std::atomic<size_t> next{0};
+  std::atomic<size_t> done{0};
+  size_t worker_count = 0;
+
+  void Work(const UploadCopyJob* j, size_t count) {
+    for (size_t i; (i = next.fetch_add(1, std::memory_order_relaxed)) < count;) {
+      std::memcpy(j[i].dst, j[i].src, j[i].size);
+      done.fetch_add(1, std::memory_order_release);
+    }
+  }
+  void EnsureWorkers(size_t count) {
+    for (; worker_count < count; ++worker_count) {
+      std::thread([this] {
+        uint64_t seen = 0;
+        while (true) {
+          const UploadCopyJob* j;
+          size_t count;
+          {
+            std::unique_lock<std::mutex> lock(mutex);
+            wake.wait(lock, [&] { return generation != seen; });
+            seen = generation;
+            j = jobs;
+            count = job_count;
+          }
+          Work(j, count);
+        }
+      }).detach();
+    }
+  }
+};
+UploadCopyPool* g_upload_copy_pool = nullptr;
+}  // namespace
+
+void D3D12SharedMemory::RunUploadCopyJobs() {
+  const size_t threads = size_t(std::max(INT32_C(0), REXCVAR_GET(shared_memory_upload_threads)));
+  const size_t count = upload_copy_jobs_.size();
+  if (threads == 0 || count < 8) {
+    for (const UploadCopyJob& job : upload_copy_jobs_) std::memcpy(job.dst, job.src, job.size);
+    upload_copy_jobs_.clear();
+    return;
+  }
+  if (!g_upload_copy_pool) g_upload_copy_pool = new UploadCopyPool();
+  UploadCopyPool& pool = *g_upload_copy_pool;
+  pool.EnsureWorkers(threads);
+  {
+    std::lock_guard<std::mutex> lock(pool.mutex);
+    pool.jobs = upload_copy_jobs_.data();
+    pool.job_count = count;
+    pool.next.store(0, std::memory_order_relaxed);
+    pool.done.store(0, std::memory_order_relaxed);
+    ++pool.generation;
+  }
+  pool.wake.notify_all();
+  pool.Work(upload_copy_jobs_.data(), count);  // this thread helps
+  while (pool.done.load(std::memory_order_acquire) < count) {
+    YieldProcessor();
+  }
+  {
+    // Workers only touch jobs/job_count under the lock, and all copies are done; make sure no
+    // worker still holds a stale pointer into upload_copy_jobs_ before it is reused.
+    std::lock_guard<std::mutex> lock(pool.mutex);
+    pool.jobs = nullptr;
+    pool.job_count = 0;
+  }
+  upload_copy_jobs_.clear();
+}
